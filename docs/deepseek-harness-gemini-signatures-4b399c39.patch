diff --git a/packages/llm/llm-pi-ai/tests/gemini-protocol.spec.ts b/packages/llm/llm-pi-ai/tests/gemini-protocol.spec.ts
index 106b449c..ac161200 100644
--- a/packages/llm/llm-pi-ai/tests/gemini-protocol.spec.ts
+++ b/packages/llm/llm-pi-ai/tests/gemini-protocol.spec.ts
@@ -81,3 +81,43 @@ it('returns a Gemini function call and replays it with its result', async () =>
     { role: 'user', parts: [{ functionResponse: { name: 'count' } }] },
   ] })
 })
+
+it.each([
+  ['+/8=', true],
+  ['+/8', true],
+  ['-_8=', true],
+  ['-_8', true],
+  ['_w==', true],
+  ['A', false],
+  ['+-8=', false],
+  ['-_8==', false],
+  ['-/8=', false],
+  ['AQI===', false],
+  ['AQ I=', false],
+  ['skip_thought_signature_validator', false],
+  ['context_engineering_is_the_way_to_go', false],
+])('preserves only valid ProtoJSON signature spellings (%s)', async (signature, valid) => {
+  const thought = { thought: true, text: 'Offline reasoning summary.', thoughtSignature: signature }
+  const text = { text: 'Offline visible text.', thoughtSignature: signature }
+  const tool = { functionCall: { name: 'count', args: { value: 2 } }, thoughtSignature: signature }
+  const server = await mockServer([reply([thought, text, tool]), reply([{ text: 'two' }])])
+  const ctx = await gateway(server.url)
+  const target = { provider: 'gemini-gateway', model: 'gemini-test' }
+  const tools = [{ name: 'count', description: 'Count fixture values.', parameters: { type: 'object' } }]
+  const user = { role: 'user' as const, content: [{ type: 'text' as const, text: 'Count the fixture values.' }] }
+  const turn = await assemble(ctx, { ...target, tools, messages: [user] })
+  expect(turn.finish).toEqual({ kind: 'tool-calls' })
+  const block = turn.message.content.find(block => block.type === 'tool-call')
+  if (!block) throw new Error('expected a tool call')
+  const result = createMessage({
+    role: 'tool', source: { kind: 'tool', callId: block.id }, toolCallId: block.id,
+    content: [{ type: 'text', text: '2' }],
+  })
+  const second = await assemble(ctx, { ...target, tools, messages: [user, turn.message, result] })
+  expect(second.finish).toEqual({ kind: 'stop' })
+  const wire = server.requests[1] as { contents: { role: string; parts: Record<string, unknown>[] }[] }
+  const parts = wire.contents.find(content => content.role === 'model')?.parts
+  expect(parts).toEqual(valid ? [thought, text, tool] : [
+    { thought: true, text: thought.text }, { text: text.text }, { functionCall: tool.functionCall },
+  ])
+})
diff --git a/patches/@earendil-works__pi-ai@1.3.0.patch b/patches/@earendil-works__pi-ai@1.3.0.patch
