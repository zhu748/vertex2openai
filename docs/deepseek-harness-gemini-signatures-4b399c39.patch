+++ b/patches/@earendil-works__pi-ai@1.3.0.patch
@@ -98,3 +98,34 @@ index 7da1c45..296d131 100644
                  break;
              }
              case "toolcall_end":
+diff --git a/dist/api/google-shared.js b/dist/api/google-shared.js
+--- a/dist/api/google-shared.js
++++ b/dist/api/google-shared.js
+@@ -104,14 +104,22 @@
+         return incoming;
+     return existing;
+ }
+-// Thought signatures must be base64 for Google APIs (TYPE_BYTES).
+-const base64SignaturePattern = /^[A-Za-z0-9+/]+={0,2}$/;
++// ProtoJSON bytes accept either Base64 alphabet, with or without padding.
++const standardSignatureAlphabet = /^[A-Za-z0-9+/]+$/;
++const urlSafeSignatureAlphabet = /^[A-Za-z0-9_-]+$/;
+ function isValidThoughtSignature(signature) {
+-    if (!signature)
++    if (!signature || signature === "skip_thought_signature_validator" ||
++        signature === "context_engineering_is_the_way_to_go")
+         return false;
+-    if (signature.length % 4 !== 0)
++    const pad = signature.indexOf("=");
++    const data = pad < 0 ? signature : signature.slice(0, pad);
++    if (!standardSignatureAlphabet.test(data) && !urlSafeSignatureAlphabet.test(data))
+         return false;
+-    return base64SignaturePattern.test(signature);
++    const tail = data.length % 4;
++    if (pad < 0)
++        return tail !== 1;
++    const expected = tail === 2 ? "==" : tail === 3 ? "=" : "";
++    return expected !== "" && signature.slice(pad) === expected;
+ }
+ /**
+  * Only keep signatures from the same provider/model and with valid base64.
