diff --git a/packages/llm/llm-pi-ai/tests/gemini-foreign-history.spec.ts b/packages/llm/llm-pi-ai/tests/gemini-foreign-history.spec.ts
new file mode 100644
index 00000000..d5d99531
--- /dev/null
+++ b/packages/llm/llm-pi-ai/tests/gemini-foreign-history.spec.ts
@@ -0,0 +1,268 @@
+/** Exact DSH adapter + pinned pi-ai + mock native Gemini wire. */
+
+import { afterEach, expect, it, onTestFinished, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { installModelSelection } from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tool-testkit'
+import LlmRuntime, { BlockAssembler, createMessage, markAgentLoopRequest } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, Message, RequestMessage, ToolCallId, UserMessage } from '@deepseek-ai/dsh-llm'
+import * as PiAi from '../src/index.ts'
+import { projectGeminiForeignHistory } from '../src/gemini-foreign-history.ts'
+import { closeMockServers, mockServer } from './mock-server.ts'
+
+const ROUTE = 'fixture-gemini'
+const OLD = 'gemini-3.6-flash'
+const NEON = 'gemini-4-neon'
+const sessionId = brandString<NonNullable<GenerateOptions['sessionId']>>('fixture-session')
+const providerOrigin = { kind: 'model' as const, provider: ROUTE, model: OLD }
+const COMPRESS = { type: 'tool-call' as const, id: brandString<ToolCallId>('old-compress'), name: 'compress',
+  arguments: '{ "chapter": "fixture" }' }
+const TOOLS = [COMPRESS.name, 'lookup', 'parallel'].map(name => ({
+  name, description: 'Return fixture data.',
+  parameters: { type: 'object', properties: {} },
+}))
+
+afterEach(async () => {
+  await closeMockServers()
+  vi.unstubAllEnvs()
+})
+
+function user(text: string): UserMessage {
+  return createMessage({ role: 'user', content: [{ type: 'text', text }], source: { kind: 'user' } }) as UserMessage
+}
+
+function switchMarker(): UserMessage {
+  const base = user('This intentionally does not use the human-facing notice wording.')
+  return { ...base, source: { kind: 'model-selection', form: 'notice', summary: 'opaque' } as UserMessage['source'] }
+}
+
+function result(id: ToolCallId, text = 'old recorded result', isError?: boolean): Message {
+  return createMessage({ role: 'tool', source: { kind: 'tool', callId: id }, toolCallId: id,
+    content: [{ type: 'text', text }], ...isError === undefined ? {} : { isError } })
+}
+
+function oldCall(): Message {
+  return createMessage({ role: 'assistant', source: providerOrigin,
+    content: [{ type: 'text', text: 'old assistant text' }, COMPRESS] })
+}
+
+function options(messages: RequestMessage[], model = NEON): GenerateOptions {
+  return { provider: ROUTE, model, sessionId, messages, tools: TOOLS }
+}
+
+function finish(parts: Record<string, unknown>[]) {
+  return { events: [JSON.stringify({ candidates: [{ content: { role: 'model', parts }, finishReason: 'STOP' }] })] }
+}
+
+async function mountAdapter(ctx: Context, url: string, enabled: boolean) {
+  vi.stubEnv('VERTEX_FIXTURE_KEY', 'offline-key')
+  await ctx.plugin(PiAi, { providers: { [ROUTE]: {
+    apiKeyEnv: 'VERTEX_FIXTURE_KEY', api: 'google-generative-ai', baseURL: url + '/v1beta',
+    models: [{ id: OLD }, { id: NEON }], geminiForeignHistoryHandoff: enabled,
+  } } })
+}
+
+async function adapter(url: string, enabled: boolean): Promise<Context> {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await ctx.plugin(LlmRuntime)
+  await mountAdapter(ctx, url, enabled)
+  return ctx
+}
+
+async function drive(ctx: Context, request: GenerateOptions, trusted = true) {
+  const assembler = new BlockAssembler()
+  for await (const chunk of ctx.llm.stream(trusted ? markAgentLoopRequest(request) : request)) assembler.push(chunk)
+  return {
+    finish: assembler.finish,
+    message: assembler.message({
+      provider: request.provider, model: request.model,
+      ...assembler.replayState === undefined ? {} : { replayState: assembler.replayState },
+    }),
+    replay: assembler.replayState,
+  }
+}
+
+type Wire = { contents: { role: string; parts: Record<string, unknown>[] }[] }
+const error400 = {
+  status: 400, body: JSON.stringify({ error: { code: 400, status: 'INVALID_ARGUMENT',
+    message: 'Function call default_api:compress in content block 2 is missing a thought_signature.' } }),
+}
+const signed = { functionCall: { name: 'lookup', id: 'neon-lookup', args: { value: 2 } }, thoughtSignature: '+/8=' }
+const follower = { functionCall: { name: 'parallel', id: 'neon-parallel', args: {} } }
+
+function strictReply(body: unknown) {
+  // Mock provider deliberately rejects a missing old required arm anywhere
+  // in history. This is a test oracle, not a claim about a live Neon backend.
+  for (const msg of (body as Wire).contents) {
+    const first = msg.parts.find(part => part['functionCall'])
+    if (first !== undefined && first['thoughtSignature'] === undefined) return error400
+  }
+  return finish([signed, follower])
+}
+
+it.each([false, true])('handles one completed foreign batch before a trusted switch; old turn settled=%s', async (settled) => {
+  const server = await mockServer([strictReply, strictReply, strictReply, strictReply])
+  const old = oldCall()
+  const oldResult = result(COMPRESS.id)
+  const history = [user('First request'), old, oldResult, ...(settled ? [
+    createMessage({ role: 'assistant', source: providerOrigin, content: [{ type: 'text', text: 'Previous model finished.' }] }),
+    user('Continue with the next model.'),
+  ] : []), switchMarker()]
+  const original = structuredClone(history)
+
+  const unpatched = await drive(await adapter(server.url, false), options(history))
+  expect(unpatched.finish).toMatchObject({ kind: 'error', failure: { code: 'INVALID_REQUEST' } })
+  expect((server.requests[0] as Wire).contents.at(-1)?.role).toBe('user')
+  expect((server.requests[0] as Wire).contents.flatMap(item => item.parts)).toContainEqual({
+    functionCall: { name: COMPRESS.name, id: COMPRESS.id, args: { chapter: 'fixture' } },
+  })
+
+  const ctx = await adapter(server.url, true)
+  const untrusted = await drive(ctx, options(history), false)
+  expect(untrusted.finish).toMatchObject({ kind: 'error', failure: { code: 'INVALID_REQUEST' } })
+  expect(server.requests[1]).toEqual(server.requests[0])
+
+  const first = await drive(ctx, options(history))
+  expect(first.finish).toEqual({ kind: 'tool-calls' })
+  expect(first.replay?.response).toMatchObject({
+    api: 'google-generative-ai', model: NEON,
+    prefixDigest: expect.stringMatching(/^dsh-gemini-foreign-tool-history\/v1:[0-9a-f]{64}$/),
+  })
+  const outgoing = (server.requests[2] as Wire).contents
+  const foreign = outgoing[1]
+  expect(foreign?.role).toBe('model')
+  expect(foreign?.parts[0]).toEqual({ text: 'old assistant text' })
+  expect(foreign?.parts[1]?.['text']).toContain(JSON.stringify({ name: COMPRESS.name,
+    id: COMPRESS.id, arguments_json: COMPRESS.arguments }))
+  expect(foreign?.parts[2]?.['text']).toContain(JSON.stringify({ id: COMPRESS.id, output: ['old recorded result'] }))
+  expect(outgoing.flatMap(item => item.parts).some(part => part['functionCall'] || part['functionResponse'])).toBe(false)
+
+  const resume = await adapter(server.url, true)
+  const echoedTarget = JSON.parse(JSON.stringify(first.message)) as Message
+  const continuation = await drive(resume, options([...history, echoedTarget,
+    result(brandString<ToolCallId>('neon-lookup'), 'two'), result(brandString<ToolCallId>('neon-parallel'), 'done'),
+  ]))
+  expect(continuation.finish).toEqual({ kind: 'tool-calls' })
+  const next = (server.requests[3] as Wire).contents
+  expect(next.slice(0, outgoing.length)).toEqual(outgoing)
+  expect(next[outgoing.length]).toEqual({ role: 'model', parts: [signed, follower] })
+  expect(next[outgoing.length + 1]).toMatchObject({ role: 'user', parts: [
+    { functionResponse: { id: 'neon-lookup', name: 'lookup', response: { output: 'two' } } },
+    { functionResponse: { id: 'neon-parallel', name: 'parallel', response: { output: 'done' } } },
+  ] })
+  expect(history).toEqual(original)
+  expect(server.paths).toEqual(Array(4).fill('/v1beta/models/gemini-4-neon:streamGenerateContent?alt=sse'))
+})
+
+it('projects only the request in a real DSH mid-turn switch and records a new tool-use proof', async () => {
+  const server = await mockServer([
+    finish([{ text: 'old answer before compress' },
+      { functionCall: { id: COMPRESS.id, name: COMPRESS.name, args: {} }, thoughtSignature: 'c2ln' }]),
+    strictReply,
+    body => strictReply(body) === error400 ? error400 : finish([{ text: 'finished after current tools' }]),
+  ])
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await mountAgentLoopTestDependencies(ctx)
+  await mountAdapter(ctx, server.url, true)
+  const harness = await mountAgentLoopTestHarness(ctx)
+  const agent = await harness.create(sessionId, { provider: ROUTE, model: OLD })
+  installModelSelection(agent.ctx)
+  const toolsCalled: string[] = []
+  for (const tool of TOOLS) {
+    ctx.tools.register(defineContentToolFixture({
+      name: tool.name, description: tool.description, parameters: {},
+      execute: async () => {
+        toolsCalled.push(tool.name)
+        if (tool.name === COMPRESS.name) agent.model.select({ provider: ROUTE, model: NEON })
+        return [{ type: 'text', text: tool.name + ' completed' }]
+      },
+    }))
+  }
+  agent.followup(user('Start a fixture task.'))
+  await agent.whenIdle()
+
+  const events = agent.session.snapshotEvents()
+  const switchIndex = events.findIndex(event => event.type === 'user/message'
+    && event.data.source.kind === 'model-selection')
+  expect(switchIndex).toBeGreaterThan(events.findIndex(event => event.type === 'tool/result'))
+  const assistants = agent.session.deriveMessages().filter(message => message.role === 'assistant')
+  expect(assistants[0]?.content.some(block => block.type === 'tool-call' && block.name === 'compress')).toBe(true)
+  expect(assistants[0]?.source.replayState).toMatchObject({
