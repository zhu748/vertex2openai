+  expect(projectGeminiForeignHistory(options([...entries, witnessed]), baseUrl + '-other')).toBeUndefined()
+  expect(projectGeminiForeignHistory(options([...entries, witnessed], 'another-model'), baseUrl)).toBeUndefined()
+})
