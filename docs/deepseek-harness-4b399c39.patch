+    blocks: [{ type: 'text', textSignature: 'c2ln' }],
+  } }, content: [{ type: 'text', text: 'accepted answer' }] })
+  const unchanged = projectGeminiForeignHistory(options([...entries, witnessed]), baseUrl)
+  expect(unchanged?.request.messages.at(-1)).toBe(witnessed)
+  for (const changed of [
