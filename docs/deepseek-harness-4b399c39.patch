+  const baseUrl = 'http://local/v1beta'
+  const entries = [intro, prior, end, marker]
+  const plan = projectGeminiForeignHistory(options(entries), baseUrl)
+  expect(plan).toBeDefined()
+  const witnessed = createMessage({ role: 'assistant', source: { kind: 'model', provider: ROUTE, model: NEON, replayState: {
+    response: { kind: 'pi-ai', version: 2, api: 'google-generative-ai', provider: ROUTE, model: NEON,
